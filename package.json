{
  "name": "@loftwah/fighter",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-production-build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "assets:launch-placeholders": "node scripts/generate-launch-placeholders.mjs",
    "assets:launch-roster": "node scripts/build-launch-art.mjs",
    "assets:trophies": "node scripts/build-trophy-art.mjs",
    "assets:music": "node scripts/sync-music.mjs",
    "content:validate": "vitest run src/content/content.test.ts",
    "demo:capture": "node scripts/capture-gameplay-demo.mjs",
    "demo:trailer": "node scripts/render-gameplay-trailer.mjs",
    "video:check": "pnpm --dir video lint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.2.6",
    "@fontsource/league-gothic": "^5.2.6",
    "lucide": "^1.29.0",
    "phaser": "^3.90.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "playwright": "^1.62.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.2.4",
    "vitest": "^4.0.15"
  },
  "packageManager": "pnpm@11.17.0"
}
